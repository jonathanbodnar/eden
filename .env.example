# PostgreSQL
EDEN_DATABASE_URL=postgresql+asyncpg://eden:eden@localhost:5432/eden
EDEN_DATABASE_URL_SYNC=postgresql://eden:eden@localhost:5432/eden

# Cloudflare R2
EDEN_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
EDEN_R2_ACCESS_KEY_ID=
EDEN_R2_SECRET_ACCESS_KEY=
EDEN_R2_BUCKET_NAME=eden-raw

# OpenAI (for embeddings)
EDEN_OPENAI_API_KEY=

# Application
EDEN_DEBUG=false
EDEN_WORKER_MAX_ATTEMPTS=3
EDEN_DEFAULT_RATE_LIMIT_RPM=60
