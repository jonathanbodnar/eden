FROM node:22-alpine AS build

WORKDIR /app
COPY world-frontend/package.json world-frontend/package-lock.json ./
RUN npm ci
COPY world-frontend/ .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY world-frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
